# 複製成 .env 並填入自己的值 (.env 已加入 .gitignore，不會進 git)
# 也可以改用系統環境變數，名稱相同
# 公開網站網址，sitemap.xml 會用它；不設定時預設為 https://5team.jryuan.org
APP_BASE_URL=https://5team.jryuan.org
DB_URL=jdbc:mysql://localhost:3306/5team
DB_USERNAME=root
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
